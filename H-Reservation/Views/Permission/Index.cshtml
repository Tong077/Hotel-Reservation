@using H_Application.DTOs.PermissionDto
@model IEnumerable<PermissionRespone>
<partial name="_style" />
<div class="card">
    <div class="card-body">
        <h4 class="card-title">Permission</h4>
        <a asp-action="Create" class="btn btn-sm btn-success mt-2 mb-2"><i class="fa-solid fa-square-plus"></i></a>
        <div class="table-responsive">
            <table class="table table-stripped table-hover  zero-configuration">
                <thead>
                    <tr>
                        <th>
                            Permission Name
                        </th>
                        <th class="text-right">
                            Action
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(items => item.Name)
                            </td>

          
                            <td class="text-right">
                                <a asp-controller="Permission" asp-action="Edit" asp-route-Id="@item.Id" class="btn btn-sm btn-outline-primary mr-1">
                                    <i class="fa-solid fa-pen-nib"></i>
                                </a>
                                <a asp-controller="Permission" asp-action="Delete" asp-route-Id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>


                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
