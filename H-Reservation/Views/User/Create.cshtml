@using H_application.DTOs.UserDto
@model UserDtoCreate

@{
    ViewData["Title"] = "Create User";
}

<div class="card">
    <div class="card-body">
        <h4 class="card-title">Add New User </h4>
        <form asp-controller="User" asp-action="Store" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <div class="form-group col-sm-6">
                    <span asp-validation-for="Username" class="text-danger"></span>
                    <label asp-for="Username" class="control-label">User Name</label>
                    <input asp-for="Username" type="text" placeholder="User Name" class="form-control" />
                </div>
                <div class="form-group col-sm-6">
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    <label asp-for="PhoneNumber" class="control-label">Phone Number</label>
                    <input asp-for="PhoneNumber" type="text" placeholder="Phone Number" class="form-control" />
                </div>
                
            </div>
            <div class="form-row">
             
                <div class="form-group col-sm-6">
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <label asp-for="Email" class="control-label">Email</label>
                    <input asp-for="Email" type="text" placeholder="Email " class="form-control" />
                </div>
                <div class="form-group col-sm-6">
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <label asp-for="Password" class="control-label">Password</label>
                    <input asp-for="Password" type="text" placeholder="Password " class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Image" class="control-label">Profile Image</label>
                <input type="file" asp-for="Image" class="form-control" id="imageUpload" accept="image/*" />
                <span asp-validation-for="Image" class="text-danger"></span>

                <!-- Image preview -->
                <div class="mt-2">
                    <img id="imagePreview" src="#" alt="Image Preview" style="max-width: 150px; max-height: 150px; display: none;" class="img-thumbnail" />
                </div>
            </div>



            <div class="form-group float-right">
                <button type="submit" class="btn btn-sm btn-success ml-1">Save</button>
                <a asp-action="Index" class="btn btn-sm btn-danger">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.getElementById('imageUpload').addEventListener('change', function(event){
        const file = event.target.files[0];
        const preview = document.getElementById('imagePreview');

        if(file){
            const reader = new FileReader();
            reader.onload = function(e){
                preview.src = e.target.result;
                preview.style.display = 'block'; // show the preview
            }
            reader.readAsDataURL(file);
        } else {
            preview.src = '#';
            preview.style.display = 'none';
        }
    });
</script>